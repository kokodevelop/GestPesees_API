{
  "Agent": {
    "SiteCode": "S001",
    "SiteName": "Carriere de Test",
    "ApiUrl": "https://api.exemple.fr",
    "ApiKey": "REMPLACER",
    "PollSeconds": 60,
    "BatchSize": 200,
    "StatePath": "state.json",
    "Sources": [
      {
        "Name": "EditeurA",
        "Provider": "MySql",
        "ConnectionString": "Server=127.0.0.1;Database=pesage;User=gestpesees_ro;Password=...;",
        "WatermarkType": "Number",
        "InitialWatermark": "0",
        "Query": "SELECT t.id AS Wm, t.id AS SourceId, t.date_pesee AS WeighedAt, t.immat AS Plate, t.produit AS Product, t.client AS ThirdParty, t.brut AS GrossKg, t.tare AS TareKg, t.net AS NetKg FROM tickets t"
      },
      {
        "Name": "EditeurB",
        "Provider": "SqlServer",
        "ConnectionString": "Server=.\\SQLEXPRESS;Database=Bascule;User Id=gestpesees_ro;Password=...;TrustServerCertificate=true",
        "WatermarkType": "DateTime",
        "InitialWatermark": "2026-01-01T00:00:00",
        "Query": "SELECT DateHeure AS Wm, NumTicket AS SourceId, DateHeure AS WeighedAt, Plaque AS Plate, Article AS Product, Tiers AS ThirdParty, PoidsBrut AS GrossKg, Tare AS TareKg, PoidsNet AS NetKg FROM dbo.Pesees"
      },
      {
        "Name": "EditeurC",
        "Provider": "Csv",
        "Folder": "C:\\Export\\Pesees",
        "FilePattern": "*.csv",
        "Delimiter": ";",
        "Encoding": "windows-1252",
        "HasHeader": true,
        "Culture": "fr-FR",
        "DateFormat": "dd/MM/yyyy HH:mm:ss",
        "DecimalSeparator": ",",
        "InitialWatermark": "{}",
        "ColumnMap": {
          "SourceId": "N° Ticket",
          "WeighedAt": "Date",
          "Plate": "Immatriculation",
          "Product": "Produit",
          "ThirdParty": "Client",
          "GrossKg": "Brut",
          "TareKg": "Tare",
          "NetKg": "Net"
        }
      }
    ]
  },
  "Logging": { "LogLevel": { "Default": "Information" } }
}
